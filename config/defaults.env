XIAOZHI_AUTODL_ROOT=/root/xiaozhi-autodl
XIAOZHI_AUTODL_RUNTIME=/root/autodl-tmp/xiaozhi-autodl
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=6006
MANAGER_WEB_PUBLIC_URL=${MANAGER_WEB_PUBLIC_URL:-}
INDEXTTS_HOST=127.0.0.1
INDEXTTS_PORT=8092
INDEXTTS_MODEL_DIR=/root/index-tts/checkpoints
INDEXTTS_DATA_DIR=/root/autodl-tmp/xiaozhi-autodl/index-tts
INDEXTTS_MAX_PENDING=4
INDEXTTS_MIN_CPU_CORES=2
INDEXTTS_MIN_MEMORY_MB=8192
INDEXTTS_MIN_GPU_MEMORY_MB=8192
XIAOZHI_CPU_THREADS=4
XIAOZHI_MIN_CPU_CORES=1
XIAOZHI_MIN_MEMORY_MB=4096
XIAOZHI_DEPENDENCY_WAIT_SECONDS=600
CHARACTER_STYLE_DIR=/root/autodl-tmp/xiaozhi-autodl/character_styles
XIAOZHI_OUTPUT_DIR=/root/autodl-tmp/xiaozhi-autodl/outputs/xiaozhi-server
