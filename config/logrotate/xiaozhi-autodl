/root/autodl-tmp/xiaozhi-autodl/logs/nginx-access.log /root/autodl-tmp/xiaozhi-autodl/logs/nginx-error.log {
    daily
    maxsize 50M
    rotate 3
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root root
    sharedscripts
    postrotate
        test ! -s /root/autodl-tmp/xiaozhi-autodl/run/nginx.pid || kill -USR1 $(cat /root/autodl-tmp/xiaozhi-autodl/run/nginx.pid) 2>/dev/null || true
    endscript
}

/root/autodl-tmp/xiaozhi-autodl/logs/mysql/*.log {
    daily
    maxsize 20M
    rotate 5
    missingok
    notifempty
    compress
    delaycompress
    create 0640 mysql mysql
    su root root
    sharedscripts
    postrotate
        /usr/bin/mysqladmin --defaults-file=/etc/mysql/debian.cnf flush-logs >/dev/null 2>&1 || true
    endscript
}

/root/autodl-tmp/xiaozhi-autodl/logs/redis/*.log {
    daily
    maxsize 20M
    rotate 5
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0660 redis adm
    su root root
}
