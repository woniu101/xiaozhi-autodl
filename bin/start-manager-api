#!/usr/bin/env bash
set -euo pipefail
jar=/root/xiaozhi-autodl/artifacts/manager-api/xiaozhi-esp32-api.jar
test -f "$jar" || { echo 'manager-api 尚未构建，请运行 scripts/build-manager-api' >&2; exit 1; }

mysql_ready=false
redis_ready=false
for _ in $(seq 1 60); do
  /usr/bin/mysqladmin --defaults-file=/etc/mysql/debian.cnf ping >/dev/null 2>&1 && mysql_ready=true
  [[ "$(/usr/bin/redis-cli --raw PING 2>/dev/null || true)" == PONG ]] && redis_ready=true
  [[ "$mysql_ready" == true && "$redis_ready" == true ]] && break
  sleep 1
done
[[ "$mysql_ready" == true ]] || { echo 'MySQL 尚未通过原生健康检查' >&2; exit 1; }
[[ "$redis_ready" == true ]] || { echo 'Redis 尚未通过 PING 健康检查' >&2; exit 1; }

export CHARACTER_STYLE_DIR=/root/xiaozhi-esp32-server/main/xiaozhi-server/data/character_styles
exec /usr/bin/java -Xms256m -Xmx1536m -jar "$jar" \
  --spring.profiles.active=dev \
  --server.address=127.0.0.1 \
  --logging.config=/root/xiaozhi-autodl/config/logback-autodl.xml
