#!/usr/bin/env bash
set -euo pipefail
python_bin=/root/miniconda3/envs/xiaozhi-esp32-server/bin/python
test -x "$python_bin" || { echo '小智 Conda 环境不存在' >&2; exit 1; }

set -a
source /root/xiaozhi-autodl/config/defaults.env
set +a
export OMP_NUM_THREADS="${XIAOZHI_CPU_THREADS:-4}"
export MKL_NUM_THREADS="$OMP_NUM_THREADS"
export OPENBLAS_NUM_THREADS="$OMP_NUM_THREADS"
export NUMEXPR_NUM_THREADS="$OMP_NUM_THREADS"
export OMP_DYNAMIC=FALSE
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export XIAOZHI_CONSOLE_LOG_ONLY=true
export CHARACTER_STYLE_DIR="${CHARACTER_STYLE_DIR:-/root/autodl-tmp/xiaozhi-autodl/character_styles}"
export XIAOZHI_OUTPUT_DIR="${XIAOZHI_OUTPUT_DIR:-/root/autodl-tmp/xiaozhi-autodl/outputs/xiaozhi-server}"
export TMPDIR="$XIAOZHI_OUTPUT_DIR"

manager_ready=false
for _ in $(seq 1 120); do
  if curl --noproxy '*' -fsS --max-time 2 http://127.0.0.1:8002/xiaozhi/user/pub-config >/dev/null 2>&1; then
    manager_ready=true
    break
  fi
  sleep 1
done
[[ "$manager_ready" == true ]] || { echo 'Manager API 在 120 秒内未就绪，小智服务端取消启动' >&2; exit 1; }

runtime_config=$(/root/xiaozhi-autodl/bin/prepare-xiaozhi-config)
export XIAOZHI_CONFIG_PATH="$runtime_config"

cd /root/xiaozhi-esp32-server/main/xiaozhi-server
exec "$python_bin" -u app.py
